# Copia este archivo a ".env" (sin ".example") y completa tus datos reales ahí.
# El archivo ".env" nunca se sube a git (ya está en .gitignore) — es solo local.

ODOO_URL=https://princesasyprincesitas.n12.incoresas.com
ODOO_DB=princesasyprincesitas.s4.incore.app
ODOO_USERNAME=
ODOO_PASSWORD=

# Contraseña para entrar al tablero (pantalla de login). Cualquier valor que
# contenga "#" u otros caracteres especiales debe ir entre comillas.
VITE_APP_PASSWORD=

# Contraseña aparte para /arqueo (herramienta de arqueo de caja para
# empleados) — distinta de VITE_APP_PASSWORD para que no vean el tablero
# financiero completo.
VITE_ARQUEO_PASSWORD=
